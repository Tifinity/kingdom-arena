random_jitter = 0.02

[sub_resource type="Resource" id="movement"]
script = ExtResource("3")
preferred_range_ratio = 1.00
lateral_span = 60.0
forward_ratio = 0.90
flank_y_bias = 0.0
kite_ratio = 0.42
kite_stop_ratio = 0.72

[resource]
script = ExtResource("1")
