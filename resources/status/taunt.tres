[gd_resource type="Resource" script_class="StatusDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/status/status_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/status/behaviors/taunt_behavior.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/fx/taunt_mark.tscn" id="3"]
[ext_resource type="Texture2D" path="res://assets/status/pixel_status.png" id="pixel_icons"]

[sub_resource type="AtlasTexture" id="icon"]
atlas = ExtResource("pixel_icons")
region = Rect2(32, 8, 8, 8)
filter_clip = true

[sub_resource type="Resource" id="behavior"]
script = ExtResource("2")

[resource]
script = ExtResource("1")
id = &"taunt"
display_name = "嘲讽"
description = "攻击目标被强制指定为嘲讽者。"
