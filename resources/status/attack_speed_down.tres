[gd_resource type="Resource" script_class="StatusDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/status/status_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/status/behaviors/stat_modifier_behavior.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/status/pixel_status.png" id="pixel_icons"]

[sub_resource type="AtlasTexture" id="icon"]
atlas = ExtResource("pixel_icons")
region = Rect2(24, 0, 8, 8)
filter_clip = true

[sub_resource type="Resource" id="behavior"]
script = ExtResource("2")
stat = &"attack_speed"
mode = 0
stronger_when_lower = true

[resource]
script = ExtResource("1")
id = &"attack_speed_down"
display_name = "攻速降低"
description = "攻击速度降低 20%。"
icon = SubResource("icon")
tags = Array[StringName]([&"debuff"])
duration = 2.5
stack_policy = 2
base_power = 0.8
behavior = SubResource("behavior")
