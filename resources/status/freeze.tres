[gd_resource type="Resource" script_class="StatusDefinition" format=3]

[ext_resource type="Script" path="res://scripts/status/status_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/status/behaviors/control_behavior.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/fx/freeze_status.tscn" id="3"]
[ext_resource type="Texture2D" path="res://assets/status/pixel_status.png" id="4"]

[sub_resource type="AtlasTexture" id="icon"]
atlas = ExtResource("4")
region = Rect2(56, 0, 8, 8)
filter_clip = true

[sub_resource type="Resource" id="behavior"]
script = ExtResource("2")

[resource]
script = ExtResource("1")
id = &"freeze"
display_name = "冰冻"
description = "被冰封，无法移动或行动，并立即打断当前动作。"
icon = SubResource("icon")
tags = Array[StringName]([&"control", &"stun"])
duration = 1.5
behavior = SubResource("behavior")
vfx_scene = ExtResource("3")
vfx_at_origin = true
